  "name": "Combat Result Bonus",
  "text": "Combat Result Bonus: Change the entry as follows: ‘Whilst in Combat Order, a Close Order formation with a Unit Strength of 10 or more may claim a bonus of +1 combat result point (see page 151).’",
  "affects": [
   "Combat Result Bonus",
   "Page 101"
  ]
 },
 {
